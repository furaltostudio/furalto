PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB (local)
MONGODB_URI=mongodb://127.0.0.1:27017/furalto

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (email verification links)
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Brevo — API key from SMTP & API → API keys)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=furaltostudio@gmail.com
BREVO_SENDER_NAME=Furalto

# Ops / billing inbox (order receipts BCC + admin alerts)
BILLING_EMAIL=furaltostudio@gmail.com

# Company details for GST tax invoices (required in production)
# Example GSTIN format: 07AABCU9603R1ZM
COMPANY_LEGAL_NAME=Furalto
COMPANY_GSTIN=
COMPANY_ADDRESS=
COMPANY_STATE=

# Behind nginx/Cloudflare set to hop count (usually 1). false disables.
TRUST_PROXY=1

# Dev seed key (optional, protects seed endpoint in production)
SEED_SECRET=dev-seed-secret

# Bootstrap admin (used by npm run seed — defaults below if unset)
ADMIN_EMAIL=furaltostudio@gmail.com
ADMIN_PASSWORD=Rahul@123
ADMIN_FIRST_NAME=Furalto
ADMIN_LAST_NAME=Admin

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Gemini (optional — design advice for custom furniture configurator)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Keep false for real Razorpay Standard Checkout. true skips gateway UI in local only.
PAYMENT_MOCK=false
